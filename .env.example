# --- Monitor ligero (/ontoy) ---
# Sondea el /ontoy de cada servicio del ecosistema, guarda estado en SQLite y
# notifica a Discord/Telegram con histeresis (no alerta hasta N fallos seguidos).
MONITOR_POLL_INTERVAL=60
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=1
MONITOR_HISTORY_RETENTION_DAYS=30
# Recordatorio periodico mientras un servicio sigue caido (0 = desactivado)
MONITOR_REMINDER_HOURS=0
MONITOR_ENVIRONMENT=production
# Dead-man's switch: URL que el monitor pinga al terminar cada ciclo (vacio = desactivado)
# Ventana de despliegue: segundos que se suprimen alertas tras /api/deploy/start sin recibir /end
MONITOR_DEPLOY_TIMEOUT=900
# gid del grupo dueño de secrets/: el monitor corre como uid 10001 y lee los secrets por grupo
MONITOR_SECRETS_GID=<gid-del-grupo-dueno-de-secrets>
# Telegram: crear bot con @BotFather y obtener el chat_id del grupo
TELEGRAM_CHAT_ID=
ONTOY_DISK_PATH=<ruta-del-filesystem-que-se-mide>

# Contrato /ontoy: nodo al que pertenece y quien reporta el host.
# Solo UN servicio por nodo lleva ONTOY_NODE_REPORTER=true.
ONTOY_NODE=<nodo donde corre, p.ej. S1>
ONTOY_NODE_REPORTER=<true en el reportero del nodo, false en los demas>
ONTOY_PEER_CHECKS=<S4=10.0.0.4:5432>
# gid del grupo docker del host: el proxy del socket corre sin root y solo expone containers/json
DOCKER_GID=<gid del grupo docker del host, getent group docker | cut -d: -f3>
