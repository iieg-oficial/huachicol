ONTOY_STACK_NAME=<nombre del stack, p.ej. portalito-ontoy>
ONTOY_CONTAINER_NAME=<nombre del contenedor, p.ej. portalito-version-api>

ONTOY_SERVICE=<slug del servicio vigilado, igual al del repo>
ONTOY_COMPOSE_PROJECT=<valor de com.docker.compose.project del stack vigilado>
ONTOY_NETWORK=<red del stack vigilado, para alcanzar sus contenedores>

ONTOY_NODE=<nodo donde corre: S1, S5, pmx-vine-wacha...>
# true en UN solo sidecar por nodo: es el que reporta CPU, RAM, swap y uptime del host.
# En S1 viven cuatro repos y solo uno debe hablar por la maquina.
ONTOY_NODE_REPORTER=<true en el reportero del nodo, false en los demas>
# Aristas hacia otros nodos, para la matriz de conectividad. Vacia si no aplica.
ONTOY_PEER_CHECKS=<S4=10.0.0.4:5432,S2=10.0.0.2:8088>

ONTOY_DISK_PATH=<ruta cuyo uso de disco se reporta, normalmente />
ONTOY_PORT_CHECKS=<nombre=host:puerto,otro=host:puerto>
# Vacia si el servicio no expone /ontoy. Si lo expone, esta URL: sus checks se mezclan
# con los del sidecar y el servicio deja de necesitar acceso al socket de Docker.
ONTOY_UPSTREAM_URL=<url del /ontoy propio del servicio, o vacia>

ONTOY_VERSION_SOURCE=<ruta en el host del archivo con la version>
ONTOY_VERSION_FILE=<ruta dentro del contenedor, conservando el nombre: /app/pyproject.toml>
ONTOY_CHANGELOG_SOURCE=<ruta en el host del CHANGELOG.md>
ONTOY_CHANGELOG_FILE=<ruta dentro del contenedor, p.ej. /app/CHANGELOG.md>

ONTOY_BIND_ADDR=<ip donde se publica el endpoint>
ONTOY_PORT=<puerto del host>
