{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Vista única del ecosistema IIEG: salud del stack, recursos del servidor, contenedores, bases de datos, gateway, logs y alertas.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Resumen general",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Targets UP",
      "description": "Targets que Prometheus puede alcanzar",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [{ "expr": "count(up == 1)", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "Targets DOWN",
      "description": "Targets que Prometheus no puede alcanzar",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [{ "expr": "count(up == 0) OR vector(0)", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "Contenedores",
      "description": "Total de contenedores corriendo",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value"
      },
      "targets": [{ "expr": "count(count by (name) (container_memory_usage_bytes{name!=\"\"}))", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "CPU",
      "description": "Uso de CPU del servidor",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [{ "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",server=\"monitoring\"}[5m]))", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "Memoria",
      "description": "Uso de memoria del servidor",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [{ "expr": "(node_memory_MemTotal_bytes{server=\"monitoring\"} - node_memory_MemAvailable_bytes{server=\"monitoring\"}) / node_memory_MemTotal_bytes{server=\"monitoring\"}", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "Disco",
      "description": "Espacio disponible en /",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "green", "value": 0.3 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [{ "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",server=\"monitoring\"} / node_filesystem_size_bytes{mountpoint=\"/\",server=\"monitoring\"}", "legendFormat": "", "refId": "A" }]
    },
    {
      "title": "Logs/seg (cluster)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [{ "expr": "sum(rate({job=\"docker\", container_name!=\"\"}[1m]))", "refId": "A", "range": true }]
    },
    {
      "title": "Uptime promedio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 3600 },
            { "color": "green", "value": 86400 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [{ "expr": "avg(time() - container_start_time_seconds{name!=\"\"})", "refId": "A", "instant": true }]
    },
    {
      "title": "Estado de servicios",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Monitoreo",
      "description": "Servicios internos del stack",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "up{job=~\"prometheus|grafana|loki|alertmanager|alloy\"}", "legendFormat": "{{ job }}", "refId": "A" }
      ]
    },
    {
      "title": "Infraestructura",
      "description": "Exporters de host y contenedores",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "up{job=\"node-exporter\"}", "legendFormat": "node ({{ server }})", "refId": "A" },
        { "expr": "up{job=\"cadvisor\"}", "legendFormat": "cadvisor ({{ server }})", "refId": "B" }
      ]
    },
    {
      "title": "Proyectos",
      "description": "Aplicaciones y bases de datos",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "up{job=\"projects\"}", "legendFormat": "{{ project }} ({{ service }})", "refId": "A" },
        { "expr": "up{job=\"acervo-seaweedfs\"}", "legendFormat": "{{ project }} ({{ service }})", "refId": "B" },
        { "expr": "up{job=\"postgres-exporter\"}", "legendFormat": "{{ project }} (postgres)", "refId": "C" }
      ]
    },
    {
      "title": "Bases de datos",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "PostgreSQL",
      "description": "Estado y conexiones activas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [{ "expr": "pg_up", "legendFormat": "{{ project }}", "refId": "A" }]
    },
    {
      "title": "Conexiones PostgreSQL",
      "description": "Total de conexiones activas por base de datos",
      "type": "bargauge",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 80 }
          ]}
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true,
        "minVizHeight": 10,
        "valueMode": "text"
      },
      "targets": [{ "expr": "sum by (datname) (pg_stat_activity_count{datname!=\"\"})", "legendFormat": "{{ datname }}", "refId": "A" }]
    },
    {
      "title": "Distribución de contenedores",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Memoria por proyecto",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "displayLabels": ["percent"]
      },
      "targets": [
        { "expr": "sum by (container_label_com_docker_compose_project) (container_memory_usage_bytes{name!=\"\", container_label_com_docker_compose_project!=\"\"})", "refId": "A", "instant": true, "legendFormat": "{{ container_label_com_docker_compose_project }}" }
      ]
    },
    {
      "title": "Contenedores por proyecto",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "continuous-BlPu" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "minVizWidth": 0,
        "minVizHeight": 16
      },
      "targets": [
        { "expr": "count by (container_label_com_docker_compose_project) (container_memory_usage_bytes{name!=\"\", container_label_com_docker_compose_project!=\"\"})", "refId": "A", "instant": true, "legendFormat": "{{ container_label_com_docker_compose_project }}" }
      ]
    },
    {
      "title": "Gateway / Red",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Requests/seg (gateway)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null },
            { "color": "green", "value": 0.5 },
            { "color": "yellow", "value": 20 },
            { "color": "red", "value": 50 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": true
      },
      "targets": [{ "expr": "sum(rate(nginx_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "title": "Conexiones activas (gateway)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 500 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": false
      },
      "targets": [
        { "expr": "nginx_connections_active", "refId": "A", "legendFormat": "Activas", "instant": true },
        { "expr": "nginx_connections_reading", "refId": "B", "legendFormat": "Leyendo", "instant": true },
        { "expr": "nginx_connections_writing", "refId": "C", "legendFormat": "Escribiendo", "instant": true },
        { "expr": "nginx_connections_waiting", "refId": "D", "legendFormat": "En espera", "instant": true }
      ]
    },
    {
      "title": "Edad del container más nuevo",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 300 },
            { "color": "green", "value": 3600 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [{ "expr": "min(time() - container_start_time_seconds{name!=\"\"})", "refId": "A", "instant": true }]
    },
    {
      "title": "Top consumo de contenedores",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Top 10 · Memoria",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "continuous-BlYlRd" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "minVizWidth": 0,
        "minVizHeight": 16
      },
      "targets": [
        { "expr": "topk(10, sum by (name) (container_memory_usage_bytes{name=~\"$container\"}))", "refId": "A", "instant": true, "legendFormat": "{{ name }}" }
      ]
    },
    {
      "title": "Top 10 · CPU",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.0,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "minVizWidth": 0,
        "minVizHeight": 16
      },
      "targets": [
        { "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[5m])))", "refId": "A", "instant": true, "legendFormat": "{{ name }}" }
      ]
    },
    {
      "title": "Estado de contenedores",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Contenedores · Uptime · Última actividad",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } },
