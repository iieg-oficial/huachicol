      "targets": [
        { "expr": "sum(rate(mapalab_embed_requests_total[5m]))", "legendFormat": "requests", "refId": "A" },
        { "expr": "sum(rate(mapalab_embed_denied_total[5m]))", "legendFormat": "denied", "refId": "B" },
        { "expr": "sum(rate(mapalab_embed_quota_exceeded_total[5m]))", "legendFormat": "quota_exceeded", "refId": "C" }
      ]
    },
