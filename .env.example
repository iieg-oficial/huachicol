# --- Grafana ---
GRAFANA_USER=
GRAFANA_PASSWORD=
GRAFANA_ROOT_URL=
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_PLUGINS=

# --- Alertas Discord ---
DISCORD_WEBHOOK_URL=

# --- Auth basica para Prometheus y Loki (temporal hasta Authentik) ---
MONITORING_AUTH_USER=
MONITORING_AUTH_PASSWORD=

# --- IPs de servidores remotos (dejar vacio si no aplica) ---
PORTAL_SERVER_IP=
MAPALAB_SERVER_IP=
MARIACHI_SERVER_IP=
GEOSERVER_SERVER_IP=
DATAENGINE_SERVER_IP=

# Single-VM (staging): si true, agrega targets locales node-exporter:9100 y
# cadvisor:8080 etiquetados como server=dataengine (ademas de server=monitoring)
# para que dashboards disenados multi-VM funcionen tambien con dataengine
# co-residente. En produccion dejar en false (DATAENGINE_SERVER_IP ya cubre).
SINGLE_VM_DATAENGINE_LOCAL=false

# --- Targets de proyectos (dejar vacio si no estan corriendo) ---
# formato: host:puerto
MAPALAB_BACKEND_TARGET=
MAPALAB_MCP_TARGET=
MARIACHI_BACKEND_TARGET=
GATEWAY_NGINX_TARGET=
DATAENGINE_POSTGRES_TARGET=
ACERVO_METRICS_TARGET=

# --- Backups a Acervo/MinIO ---
# Credenciales del usuario huachicol-user (generado por init-buckets en Acervo)
# NO usar credenciales de administrador — solo acceso al bucket huachicol
MINIO_ENDPOINT=
MINIO_BUCKET_USER=
MINIO_BUCKET_PASSWORD=

# --- Bind de puertos internos (prometheus, alertmanager, node-exporter, cadvisor) ---
# Estos servicios solo los consumen Grafana y nginx-auth por la red Docker interna,
# nunca desde otra VM. Prometheus corre con --web.enable-admin-api: expuesto en la LAN
# permite borrar series sin autenticacion.
#   single-VM (dev/staging) y S1 (produccion): 127.0.0.1
#   0.0.0.0 solo si un host externo debe alcanzarlos directamente
# El acceso remoto autenticado va por nginx-auth (PROMETHEUS_AUTH_PORT/LOKI_AUTH_PORT),
# que si escucha en todas las interfaces.
BIND_ADDR=127.0.0.1

# --- Puertos ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9002
LOKI_PORT=9003
NODE_EXPORTER_PORT=9010
CADVISOR_PORT=9011
PROMETHEUS_AUTH_PORT=9091
LOKI_AUTH_PORT=3101

# --- Monitor ligero (/ontoy) ---
# Sondea el /ontoy de cada servicio del ecosistema, guarda estado en SQLite y
# notifica a Discord/Telegram con histeresis (no alerta hasta N fallos seguidos).
MONITOR_POLL_INTERVAL=60
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=1
MONITOR_HISTORY_RETENTION_DAYS=30
# Recordatorio periodico mientras un servicio sigue caido (0 = desactivado)
MONITOR_REMINDER_HOURS=0
MONITOR_ENVIRONMENT=production
MONITOR_API_PORT=8090
# Webhook propio del monitor (puede ser distinto al de alertmanager)
MONITOR_DISCORD_WEBHOOK_URL=
# Telegram: crear bot con @BotFather y obtener el chat_id del grupo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
