SERVER_NAME=<nombre del servidor, ej: portal, mapalab, mariachi, geoserver>

LOKI_URL=http://<ip-servidor-monitoring>:9003

# --- Alloy (logs + node metrics, profiles: all, telemetry) ---
ALLOY_PORT=12345

# --- cAdvisor (profiles: all, cadvisor) ---
CADVISOR_PORT=8080

# --- PostgreSQL Exporter (profile: postgres) ---
POSTGRES_DSN=postgresql://usuario:password@host:5432/basedatos?sslmode=disable
POSTGRES_EXPORTER_PORT=9187
